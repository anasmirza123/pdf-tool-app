{
  <!-- Use the relative path to point to the correct subfolder -->
<img src="assets/logo.png" alt="Logo">
"name": "DocuForge - PDF & Document Tools",
  "short_name": "DocuForge",
  "description": "Fast, secure, and private online tools to merge, split, compress, convert, rotate, OCR, and edit PDFs, images, and documents directly in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
<!-- If the file is in the root directory -->
<link rel="manifest" href="/site.webmanifest">

<!-- OR if the file is in a subfolder -->
<link rel="manifest" href="/assets/site.webmanifest">
}
